# Copy to .env and fill local/test values. This file intentionally contains
# placeholders only; production secrets must come from the deployment system.
DB_URL=jdbc:mysql://host.docker.internal:3306/douyin?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=douyin
DB_PASSWORD=change-me
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
DOUYIN_KAFKA_ENABLED=true
JWT_SECRET=base64-encoded-32-byte-secret
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev
API_A_PORT=9191
API_B_PORT=9192
RTC_NODE_ID_A=p0-api-a
RTC_NODE_ID_B=p0-api-b
